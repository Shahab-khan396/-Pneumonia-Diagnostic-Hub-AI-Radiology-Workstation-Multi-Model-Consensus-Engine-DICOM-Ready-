# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
dist/
build/

# ── Environments & Secrets ────────────────────────────────────
.env
.env.*
*.env
!.env.example
!frontend/.env.local.example

# ── Virtual Environments ──────────────────────────────────────
.venv/
env/
venv/
ENV/

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node.js & Frontend Builds ─────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.vercel/
frontend/.vercel/

# ── Runtime Generated Files (uploads, Grad-CAM, reports) ──────
# These are created at runtime and must never be committed.
static/uploads/*
!static/uploads/.gitkeep
static/reports/*
!static/reports/.gitkeep
# Keep sample X-rays (they are curated assets, not runtime files)
# static/samples/ is intentionally tracked

# ── Model Training Artifacts ──────────────────────────────────
# Notebook outputs, training plots, comparison CSVs
models/training_histories.png
models/model_comparison.txt
models/model_comparison.csv
models/yolo_inference_samples.png
# Base/pretrain weights not needed in repo (download separately)
models/yolov8n.pt
models/last.pt

# ── Large & Unused Model Weights ─────────────────────────────
# Only the 4 active models are tracked: mobilenet, densenet121,
# efficientnet, xception + yolov8_pneumonia.pt
# VGG19 and ResNet50 are no longer used by the production app.
models/VGG19_model.h5
models/resnet50_model.h5

# ── Jupyter Notebook Junk ────────────────────────────────────
.ipynb_checkpoints/

# ── IDE & OS ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────
archive.zip
chest_xray/
*.log
